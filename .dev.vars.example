SEARXNG_BASE_URL=
SEARXNG_DISCOVERY_URL=https://searx.space/data/instances.json
SEARXNG_ENABLE_FALLBACK_ROTATION=true
SEARXNG_DISCOVERY_CANDIDATE_LIMIT=8
SEARXNG_DISCOVERY_MAX_ATTEMPTS=4
SEARXNG_EMPTY_RESULT_RETRIES=1
SEARXNG_MIN_UPTIME_WEEK=95
SEARXNG_MIN_SEARCH_SUCCESS=70
SEARXNG_ENGINES=google,bing
SEARXNG_CATEGORIES=general
SEARXNG_TIME_RANGE=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=glm-5
OLLAMA_PLAN=free
OLLAMA_API_KEY=replace-me
# Optional local estimate budgets for the usage panel.
# Ollama does not publish exact remaining quota in the public API, so these are manual estimates if you know them.
# OLLAMA_ESTIMATED_SESSION_TOKEN_BUDGET=250000
# OLLAMA_ESTIMATED_WEEKLY_TOKEN_BUDGET=1500000
# OLLAMA_ESTIMATED_SESSION_RUNTIME_BUDGET_NS=900000000000
# OLLAMA_ESTIMATED_WEEKLY_RUNTIME_BUDGET_NS=6000000000000
